# Variables de entorno que espera basedatos.py para conectarse a PostgreSQL
# (specs/002-login/plan.md, D2). Copia este archivo a ".env" y completa los
# valores reales; ".env" está excluido del repositorio (.gitignore).

MOVIFACE_DB_HOST=localhost
MOVIFACE_DB_PORT=5432
MOVIFACE_DB_NAME=moviface
MOVIFACE_DB_USER=moviface
MOVIFACE_DB_PASSWORD=

# Solo la usa configurar_base_datos.py: una base de datos que ya
# exista en el servidor (para poder crear MOVIFACE_DB_NAME si no
# existe todavía). Por defecto "postgres".
MOVIFACE_DB_ADMIN_NAME=postgres
